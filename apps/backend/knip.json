{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["scripts/*.ts"],
  "project": ["src/**/*.ts", "scripts/**/*.ts"],
  "ignore": [
    "src/domain/_shared/**",
    "src/infra/http/handler.ts",
    "src/infra/http/middleware/**",
    "src/infra/persistence/**"
  ],
  "ignoreBinaries": ["eslint", "tsc", "tsx", "vitest", "prisma"],
  "ignoreDependencies": ["eslint", "lint-staged", "madge", "tsx", "prisma"],
  "ignoreExportsUsedInFile": true
}
